#!/usr/bin/env bash
# Fast checks on what is staged. Anything slow belongs in pre-push or CI.
set -euo pipefail
. "$(dirname "$0")/lib/common.sh"
warn_if_stale

MAX_FILE_BYTES=$((1024 * 1024))
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# Whitespace errors and leftover conflict markers.
git diff --cached --check || fail "fix the whitespace errors or conflict markers above"

while IFS= read -r path; do
  size="$(git cat-file -s ":$path")"
  [ "$size" -le "$MAX_FILE_BYTES" ] || fail "$path is $size bytes; files over 1 MiB don't belong in this repo"
  if printf '%s\n' "$path" | grep -qE "$SECRET_FILE_NAMES" \
    && ! printf '%s\n' "$path" | grep -qE '\.(example|sample|template)$'; then
    fail "$path looks like a credentials file; keep it out of git"
  fi
done <<< "$staged"

hits="$(git diff --cached -U0 --no-color | find_secrets)"
[ -z "$hits" ] || fail "possible credential in staged changes (add 'secret-scan: allow' to the line if it is a deliberate fake):
$hits"
